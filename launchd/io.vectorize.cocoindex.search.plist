<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.vectorize.cocoindex.search</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.engram/venv/bin/engram-search-configured</string>
        <string>--project</string>
        <string>kubernaut</string>
        <string>--config</string>
        <string>__HOME__/.engram/projects.toml</string>
        <string>--transport</string>
        <string>streamable-http</string>
        <string>--port</string>
        <string>8890</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Project paths and database settings are loaded from
             __HOME__/.engram/projects.toml. -->
        <key>PATH</key>
        <string>__HOME__/.engram/venv/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__HOME__/.engram</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.engram/logs/cocoindex-search-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.engram/logs/cocoindex-search-stderr.log</string>
</dict>
</plist>
