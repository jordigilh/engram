<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.vectorize.cocoindex.service</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.hindsight/with-config-env.sh</string>
        <string>__HOME__/.hindsight/venv/bin/engram-flows-kubernaut</string>
        <string>--mode</string>
        <string>live</string>
        <!-- transcripts deliberately excluded: it's the only app in any
             onboarded project's flow that makes live LLM calls (Haiku
             correction_gate.is_correction() per new transcript message,
             occasionally escalating to Sonnet via
             contradiction_resolution.resolve()) -- see docs/FINDINGS.md
             2026-08-13. Cut to manually-triggered only
             (`engram-flows-kubernaut --mode backfill --apps transcripts`)
             pending a cost/value decision; nightly-learn.py's existing
             hourly/nightly batch pass still covers correction detection on
             a much lower-frequency schedule in the meantime. -->
        <string>--apps</string>
        <string>docs</string>
        <string>issues</string>
        <string>code</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- These five point at the read-only branch-scoped mirrors from
             watch-mirrors-config.sh (kept in sync by refresh-watch-mirrors.sh
             via launchd/io.vectorize.cocoindex.watch-sync.plist), NOT the
             live dev clones under ~/go/src/github.com/jordigilh/. See
             docs/FINDINGS.md 2026-08-03: watching the live clones meant
             every branch checkout during routine PR work was misread as a
             real content delta, triggering a full hindsight_retain() +
             Sonnet consolidation pass per touched file. -->
        <key>ENGRAM_DOCS_DIR</key>
        <string>__HOME__/.hindsight/watch/kubernaut-docs/docs</string>
        <key>ENGRAM_CODE_DIR</key>
        <string>__HOME__/.hindsight/watch/kubernaut</string>
        <key>ENGRAM_TRANSCRIPTS_DIR</key>
        <string>__HOME__/.cursor/projects</string>
        <key>ENGRAM_OPERATOR_DIR</key>
        <string>__HOME__/.hindsight/watch/kubernaut-operator</string>
        <key>ENGRAM_CONSOLE_DIR</key>
        <string>__HOME__/.hindsight/watch/kubernaut-console</string>
        <key>ENGRAM_SCENARIOS_DIR</key>
        <string>__HOME__/.hindsight/watch/kubernaut-demo-scenarios</string>
        <key>ENGRAM_ISSUES_REPOS</key>
        <string>jordigilh/kubernaut,jordigilh/kubernaut-operator,jordigilh/kubernaut-console,jordigilh/kubernaut-demo-scenarios</string>
        <!-- Kept in sync by hand with watch-mirrors-config.sh's RELEASE_LINES
             -- code_main additionally indexes these release-line mirrors
             (docs/issues stay main-only, unchanged). See docs/FINDINGS.md
             2026-08-10. -->
        <key>KUBERNAUT_RELEASE_LINES</key>
        <string>v1.5,v1.6</string>
        <key>HINDSIGHT_URL</key>
        <string>http://localhost:8888</string>
        <key>COCOINDEX_PG_URL</key>
        <string>postgresql://hindsight:hindsight@localhost:5432/hindsight</string>
        <!-- code_app's pgvector pool -- right-sized down from asyncpg's own
             min_size=10/max_size=10 default, since every onboarded project's
             cocoindex-flows.py opens its own pool against this same shared
             Postgres instance. See docs/FINDINGS.md 2026-08-03. -->
        <key>COCOINDEX_PG_POOL_MIN_SIZE</key>
        <string>2</string>
        <key>COCOINDEX_PG_POOL_MAX_SIZE</key>
        <string>5</string>
        <key>PATH</key>
        <string>__HOME__/.hindsight/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__HOME__/.hindsight</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.hindsight/logs/cocoindex-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.hindsight/logs/cocoindex-stderr.log</string>
</dict>
</plist>
