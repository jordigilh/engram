#!/usr/bin/env bash
# Install an immutable OpenCode plugin artifact from a GitHub Release.

set -euo pipefail

VERSION="${1:-}"
if [[ -z "${VERSION}" || "${VERSION}" == -* || "${VERSION}" == *[!0-9A-Za-z._-]* ]]; then
  printf 'usage: %s VERSION\n' "${0##*/}" >&2
  exit 2
fi

REPOSITORY="${ENGRAM_PLUGIN_RELEASE_REPO:-jordigilh/engram}"
INSTALL_ROOT="${ENGRAM_PLUGIN_INSTALL_ROOT:-${HOME}/.engram/opencode-plugins}"
ASSET="engram-opencode-plugin-${VERSION}.tar.gz"
BASE_URL="https://github.com/${REPOSITORY}/releases/download/opencode-plugin-v${VERSION}"
TEMP_ROOT="$(mktemp -d)"
STAGING="${INSTALL_ROOT}/.engram-opencode-plugin-${VERSION}.tmp-$$"
DESTINATION="${INSTALL_ROOT}/engram-opencode-plugin-${VERSION}"

cleanup() {
  rm -rf "${TEMP_ROOT}" "${STAGING}"
}
trap cleanup EXIT

mkdir -p "${INSTALL_ROOT}"
curl --fail --location --silent --show-error "${BASE_URL}/${ASSET}" -o "${TEMP_ROOT}/${ASSET}"
curl --fail --location --silent --show-error "${BASE_URL}/${ASSET}.sha256" -o "${TEMP_ROOT}/${ASSET}.sha256"

expected="$(awk '{print $1}' "${TEMP_ROOT}/${ASSET}.sha256")"
actual="$(shasum -a 256 "${TEMP_ROOT}/${ASSET}" | awk '{print $1}')"
if [[ -z "${expected}" || "${actual}" != "${expected}" ]]; then
  printf 'checksum mismatch for %s\n' "${ASSET}" >&2
  exit 1
fi

if [[ -e "${DESTINATION}" ]]; then
  printf '%s\n' "${DESTINATION}"
  exit 0
fi

mkdir -p "${STAGING}"
tar -xzf "${TEMP_ROOT}/${ASSET}" -C "${STAGING}"
test -f "${STAGING}/package.json"
test -f "${STAGING}/index.js"
test -f "${STAGING}/build-info.json"
mv "${STAGING}" "${DESTINATION}"

printf '%s\n' "${DESTINATION}"
