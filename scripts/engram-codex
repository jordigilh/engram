#!/bin/sh
# Launch Codex with the Engram route for the current checkout/branch.
# Codex configuration has no Git-branch interpolation, so override only the
# MCP URL for this invocation and leave the user's normal config untouched.
set -eu

if ! command -v codex >/dev/null 2>&1; then
  printf '%s\n' "engram-codex: codex is not on PATH" >&2
  exit 127
fi

gateway=${ENGRAM_GATEWAY_URL:-http://127.0.0.1:8896}
case "$gateway" in
  *[!A-Za-z0-9:/._-]*)
    printf '%s\n' "engram-codex: ENGRAM_GATEWAY_URL contains unsupported characters" >&2
    exit 2
    ;;
esac

root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
directory=$(basename "$root")
route=${ENGRAM_CODEX_PROJECT:-$directory}

if [ -z "${ENGRAM_CODEX_PROJECT:-}" ]; then
  branch=$(git -C "$root" branch --show-current 2>/dev/null || true)
  suffix=main
  case "$directory" in
    *-v[0-9]*.[0-9]*) suffix=${directory##*-} ;;
  esac
  case "$branch" in
    release/v[0-9]*.[0-9]*) suffix=${branch#release/} ;;
  esac

  # Optional comma-separated mappings keep branch-aware routing generic:
  #   ENGRAM_CODEX_BRANCH_ROUTES='main=project,release/v1.5=project-v1.5'
  # Try the exact branch first, then the normalized release suffix, matching
  # the OpenCode plugin's branchRoutes behavior.
  mappings=${ENGRAM_CODEX_BRANCH_ROUTES:-}
  old_ifs=$IFS
  matched=0
  selected=
  for key in "$branch" "$suffix" "release/$suffix"; do
    [ -n "$key" ] || continue
    IFS=,
    for mapping in $mappings; do
      mapping_key=${mapping%%=*}
      mapping_value=${mapping#*=}
      if [ "$mapping_key" = "$key" ]; then
        selected=$mapping_value
        matched=1
        break
      fi
    done
    IFS=$old_ifs
    [ "$matched" -eq 1 ] && break
  done
  if [ "$matched" -eq 1 ]; then
    route=$selected
  fi
fi

case "$route" in
  ""|*[!A-Za-z0-9._-]*)
    printf '%s\n' "engram-codex: derived project route is invalid" >&2
    exit 2
    ;;
esac

override="mcp_servers.engram.url=\"$gateway/mcp/$route\""
printf '%s\n' "[engram-codex] project=$route directory=$directory gateway=$gateway" >&2
exec codex -c "$override" "$@"
