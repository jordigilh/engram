<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.vectorize.cocoindex.watch-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.engram/refresh-watch-mirrors.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.engram/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__HOME__/.engram</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.engram/logs/watch-mirrors-sync-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.engram/logs/watch-mirrors-sync-stderr.log</string>
</dict>
</plist>
