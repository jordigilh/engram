# Native host gateway registry.
# Copy to ~/.engram/runtime/native-instances.toml and replace every endpoint,
# command, and workspace path with values for this deployment. The populated
# file is intentionally not tracked by Engram.

[instances."my-project".backends.docs]
kind = "http"
url = "http://127.0.0.1:8888/mcp/my-project-docs/"

[instances."my-project".backends.issues]
kind = "http"
url = "http://127.0.0.1:8888/mcp/my-project-issues/"

# Optional read-only shared methodology memory. The gateway only exposes
# recall/get_mental_model for this backend; callers must use the documented
# project-tag filter and must not use it as a writable project bank.
[instances."my-project".backends.hindsight]
kind = "http"
url = "http://127.0.0.1:8888/mcp/shared-memory/"
scope_tags = ["my-project"]
mental_model_ids = ["my-project-methodology"]

[instances."my-project".backends.code]
kind = "http"
# zvec-grep is the code backend: semantic search, call graph, code graph, and
# the managed rg engine behind the public `search_for_pattern` tool.
url = "http://127.0.0.1:7999/mcp"
headers = { Host = "localhost:7999" }
timeout_seconds = 300

# Alternative: a code backend that runs as a separate process on the host.
# Use this only when an HTTP zvec-grep endpoint is not available.
#
# [instances."my-project".backends.code]
# kind = "stdio"
# command = "/path/to/zg"
# args = ["--server", "--stdio", "--mcp-toolset", "full"]
# shared_key = "my-project-code"

[instances."my-project".backends.serena]
kind = "stdio"
command = "/path/to/serena"
args = ["start-mcp-server", "--project", "/path/to/my-project"]
# This Serena process is pinned to one checkout. Use an HTTP
# serena-multiplex endpoint instead when the OpenCode plugin sends workspace
# context for linked worktrees.
workspace_routing = false

# A shadow backend is optional. Its source_roots are deployment-local because
# they authorize which local workspaces may be used for comparisons. A
# configured Git checkout also covers its registered linked Git worktrees;
# non-Git aggregate roots still need an exact allowed_roots entry.
#
# CocoIndex is ingestion-only; there is no CocoIndex code backend to shadow.
# A shadow backend compares two zvec-grep endpoints when testing a new zvec
# build against the current one.
#
# [instances."my-project".backends.code_shadow]
# kind = "shadow_http"
# url = "http://127.0.0.1:7999/mcp"
# A second zvec-grep build to compare against the primary above.
# shadow_url = "http://127.0.0.1:7998/mcp"
# timeout_seconds = 300
# shadow_timeout_seconds = 180
# shadow_log = "~/.engram/logs/code-shadow.jsonl"
# source_roots = { my-project = "/path/to/my-project" }
# allowed_roots = ["/path/to/my-project"]
