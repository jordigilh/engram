# Hindsight LLM configuration -- the single source of truth for every process
# that talks to an LLM (hindsight-api itself, nightly-learn.py, cocoindex-flows.py,
# prefilter-shadow-trial.py, backfill scripts, etc).
#
# This file is never committed (see .gitignore) and its values are never
# duplicated into any repo-tracked file, including the launchd/*.plist
# templates -- those are committed to a public repo. Instead, every launchd
# job's ProgramArguments runs through with-config-env.sh, which `source`s
# this file into the process environment at runtime, exactly like start.sh
# already does for the dev flow. See docs/FINDINGS.md 2026-07-27 for the
# production incident this fixed: launchd jobs that didn't go through
# with-config-env.sh (or an equivalent inline EnvironmentVariables copy) ran
# with none of these vars set, so spike/classify.py's os.environ.setdefault()
# silently substituted its public placeholder project ID and every Haiku
# correction-detection call failed with a 403.

HINDSIGHT_API_PORT=8888
HINDSIGHT_API_LLM_PROVIDER=litellm
HINDSIGHT_API_LLM_MODEL=vertex_ai/claude-sonnet-4-6
HINDSIGHT_API_RETAIN_LLM_PROVIDER=litellm
HINDSIGHT_API_RETAIN_LLM_MODEL=vertex_ai/claude-haiku-4-5@20251001
VERTEXAI_PROJECT=your-gcp-project-id
VERTEXAI_LOCATION=global
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=true
HINDSIGHT_API_RERANKER_LOCAL_FORCE_CPU=true
# Pool sized for a single-user local deployment, not the upstream default of
# 100 (see docs/FINDINGS.md 2026-06-26 -- an oversized pool was 6.6GB of a
# 17GB heap leak). 15 (not 10) plus a worker slot cap below leaves headroom
# for HTTP requests even when the background worker's startup task-claim
# burst is active -- see docs/FINDINGS.md 2026-08-02.
HINDSIGHT_API_DB_POOL_MIN_SIZE=2
HINDSIGHT_API_DB_POOL_MAX_SIZE=15

# Caps how many DB connections the in-process background worker (consolidation,
# graph_maintenance, etc.) can claim at once. Without this, it can claim up to
# its own default of 10 -- the same size as a *default* pool -- and starve
# recall/health requests for up to ~60-70s right after every restart. See
# docs/FINDINGS.md 2026-08-02.
HINDSIGHT_API_WORKER_MAX_SLOTS=5

# Points at a Postgres instance you manage independently of hindsight-api
# (e.g. via launchd/io.vectorize.hindsight.postgres.plist), NOT the default
# "pg0" marker. A plain postgresql:// URL here makes
# hindsight_api.pg0.resolve_database_url() a no-op, so hindsight-api never
# starts/stops/owns Postgres itself -- recommended for any always-on,
# multi-project setup, since pg0-embedded's self-management caused two
# outages in two days on the reference deployment (see docs/findings/2026-08.md).
# Must be a plain libpq-style URL, not postgresql+asyncpg://, which crashes
# asyncpg.create_pool() on the hot path. Omit this var entirely to keep using
# pg0-embedded (fine for a quick single-user/throwaway setup).
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:hindsight@localhost:5432/hindsight
