#!/bin/sh
# Restarts the family's shared MCP daemon(s) (debounced -- see
# _restart-{{FAMILY_NAME}}-daemons.sh).
#
# Use this variant when several repos share one long-lived HTTP MCP daemon.
# For a standalone project with no shared daemon, use ../generic/ instead.
#
# Generated from git-hooks/family/post-checkout-family-mcp.sh.tmpl -- see
# git-hooks/README.md and docs/NEW_PROJECT_SETUP.md steps 8a/14.

set -e

HOOKS_SRC_DIR=$(dirname "$0")
[ -L "$0" ] && HOOKS_SRC_DIR=$(dirname "$(readlink "$0")")
GIT_HOOKS_DIR=$(git rev-parse --git-path hooks 2>/dev/null) || GIT_HOOKS_DIR=""

if [ -n "$GIT_HOOKS_DIR" ] && [ -d "$GIT_HOOKS_DIR" ] && [ ! -e "$GIT_HOOKS_DIR/post-merge" ]; then
    ln -sf "$HOOKS_SRC_DIR/post-merge-{{FAMILY_NAME}}-mcp.sh" "$GIT_HOOKS_DIR/post-merge" 2>/dev/null || true
fi
if [ -n "$GIT_HOOKS_DIR" ] && [ -d "$GIT_HOOKS_DIR" ] && [ ! -e "$GIT_HOOKS_DIR/reference-transaction" ]; then
    ln -sf "$HOOKS_SRC_DIR/reference-transaction-{{FAMILY_NAME}}-mcp.sh" "$GIT_HOOKS_DIR/reference-transaction" 2>/dev/null || true
fi

if [ -f "$HOOKS_SRC_DIR/_restart-{{FAMILY_NAME}}-daemons.sh" ]; then
    "$HOOKS_SRC_DIR/_restart-{{FAMILY_NAME}}-daemons.sh" 2>/dev/null || true
fi

exit 0
