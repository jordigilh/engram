<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.vectorize.cocoindex.kuadrant</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.engram/with-config-env.sh</string>
        <string>__HOME__/.engram/venv/bin/engram-flows-kuadrant</string>
        <string>--mode</string>
        <string>live</string>
        <!-- Ingestion-only onboarding (2026-08-27, extended to 9 repos
             2026-08-28 with mcp-gateway): docs/issues/code apps plus
             git-sync (periodic `git pull` across all 9 read-only
             checkouts -- see kuadrant.py's module docstring for why this
             exists: nobody opens these repos as a Cursor workspace, so
             nothing else keeps them in sync with upstream). No serena, no
             transcripts app (this org has no Cursor agent sessions of its
             own). -->
        <string>--apps</string>
        <string>docs</string>
        <string>issues</string>
        <string>code</string>
        <string>git-sync</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Project paths and service settings are loaded from
             __HOME__/.engram/projects.toml. -->
        <key>PATH</key>
        <string>__HOME__/.engram/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__HOME__/.engram</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.engram/logs/cocoindex-kuadrant-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.engram/logs/cocoindex-kuadrant-stderr.log</string>
</dict>
</plist>
