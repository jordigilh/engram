<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.vectorize.cocoindex.praxis</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.engram/with-config-env.sh</string>
        <string>__HOME__/.engram/venv/bin/engram-flows-configured</string>
        <string>--project</string>
        <string>praxis</string>
        <string>--config</string>
        <string>__HOME__/.engram/projects.toml</string>
        <string>--mode</string>
        <string>live</string>
        <!-- The generic issues connector includes GitHub issues/PRs,
             Discussions, Projects, and Jira sources from projects.toml. -->
        <string>--apps</string>
        <string>docs</string>
        <string>issues</string>
        <string>code</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Project paths and service settings are loaded from
             __HOME__/.engram/projects.toml. -->
        <key>PATH</key>
        <string>__HOME__/.engram/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__HOME__/.engram</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.engram/logs/cocoindex-praxis-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.engram/logs/cocoindex-praxis-stderr.log</string>
</dict>
</plist>
