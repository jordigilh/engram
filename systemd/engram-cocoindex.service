# systemd unit (native, Linux) -- long-running CocoIndex continuous sync
# (docs, code, issues, transcripts). Direct analog of
# launchd/io.vectorize.cocoindex.service.plist.
#
# Runs natively via the same `uv`-managed venv as the maintenance units -- see
# engram-hindsight-hourly.service for rationale. Project paths, repository
# mappings, and service settings are read from ~/.engram/projects.toml;
# credentials remain in ~/.engram/config.env.
#
# Install (user-level, mirrors launchd's per-user LaunchAgents):
#   cp systemd/engram-cocoindex.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now engram-cocoindex.service

[Unit]
Description=CocoIndex continuous sync (docs, code, issues, transcripts)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.engram
EnvironmentFile=%h/.engram/config.env
ExecStart=%h/.engram/venv/bin/engram-flows-kubernaut --mode live
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/.engram/logs/cocoindex-stdout.log
StandardError=append:%h/.engram/logs/cocoindex-stderr.log

[Install]
WantedBy=default.target
