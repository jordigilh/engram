# Deployment-local integrity policy for scripts/run-zvec-grep-container.sh.
# Copy this file to ~/.engram/zvec-grep/trusted-digests.env and replace both
# values with the platform-specific digests obtained from the authorized Quay
# publication. Do not commit the populated file.
ZVEC_GREP_IMAGE_DIGEST_LINUX_AMD64=sha256:<verified-zvec-grep-amd64-digest>
ZVEC_GREP_IMAGE_DIGEST_LINUX_ARM64=sha256:<verified-zvec-grep-arm64-digest>
ZVEC_GREP_PROXY_IMAGE_DIGEST_LINUX_AMD64=sha256:<verified-proxy-amd64-digest>
ZVEC_GREP_PROXY_IMAGE_DIGEST_LINUX_ARM64=sha256:<verified-proxy-arm64-digest>
