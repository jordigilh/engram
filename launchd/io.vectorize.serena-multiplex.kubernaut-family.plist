<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.vectorize.serena-multiplex.kubernaut-family</string>
    <!-- Sits in front of io.vectorize.serena.kubernaut-family (port 8892) and
         gives every one of the 6 family repos its own fixed HTTP mount
         (/mcp/<project>) with full read+write, instead of just whichever repo
         last called activate_project on the shared daemon. See
         src/engram/pipeline/serena_multiplex.py's module docstring and
         docs/findings/2026-08.md, 2026-08-13 (same day, ninth follow-up) for
         the full design rationale, including a real bug hit and fixed along
         the way (fastmcp's Client/create_proxy crashed the upstream daemon on
         SSE-stream reconnect -- this module hand-rolls a one-shot httpx POST
         relay instead, which does not have that problem).

         --project is repeatable; each value must match a name registered in
         ~/.serena/serena_config.yml's `projects:` list (specifically each
         project's own .serena/project.yml `project_name:` field), not a repo
         path. -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.hindsight/venv/bin/engram-serena-multiplex</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8893</string>
        <string>--upstream-url</string>
        <string>http://127.0.0.1:8892/mcp</string>
        <string>--project</string>
        <string>kubernaut</string>
        <string>--project</string>
        <string>kubernaut-operator</string>
        <string>--project</string>
        <string>kubernaut-console</string>
        <string>--project</string>
        <string>kubernaut-demo-scenarios</string>
        <string>--project</string>
        <string>kubernaut-v1.5</string>
        <string>--project</string>
        <string>kubernaut-v1.6</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.hindsight/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.hindsight/logs/serena-multiplex-kubernaut-family-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.hindsight/logs/serena-multiplex-kubernaut-family-stderr.log</string>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
