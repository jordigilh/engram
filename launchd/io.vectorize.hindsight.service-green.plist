<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.vectorize.hindsight.service-green</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.hindsight/with-config-env.sh</string>
        <string>__HOME__/.hindsight/venv/bin/hindsight-api</string>
        <string>--port</string>
        <string>18889</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- See io.vectorize.hindsight.service-blue.plist for why LLM config
             is never duplicated here, and why --port (not an env var) is
             what pins this instance to the "green" port. -->
        <key>PATH</key>
        <string>__HOME__/.hindsight/venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__HOME__/.hindsight</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.hindsight/logs/hindsight-stdout-green.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.hindsight/logs/hindsight-stderr-green.log</string>
</dict>
</plist>
