<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.vectorize.engram-gateway-configured</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.engram/venv/bin/engram-gateway</string>
        <string>--config</string>
        <string>__HOME__/.engram/runtime/instances.toml</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8896</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.engram/logs/engram-gateway-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.engram/logs/engram-gateway-stderr.log</string>
</dict>
</plist>
