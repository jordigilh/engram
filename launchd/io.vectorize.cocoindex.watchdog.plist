<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Safety net for the silent-launchd-unload failure class, see
         docs/FINDINGS.md 2026-08-12. Checks every "live" cocoindex service
         every 15 min and re-bootstraps + logs if one is missing. -->
    <key>Label</key>
    <string>io.vectorize.cocoindex.watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.hindsight/cocoindex-watchdog.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.hindsight/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__HOME__/.hindsight</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.hindsight/logs/cocoindex-watchdog-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.hindsight/logs/cocoindex-watchdog-stderr.log</string>
</dict>
</plist>
