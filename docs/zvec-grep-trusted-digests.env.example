# Deployment-local integrity policy for scripts/run-zvec-grep-container.sh.
# Copy this file to ~/.engram/zvec-grep/trusted-digests.env and replace both
# values with the platform-specific digests obtained from the authorized Quay
# publication. Do not commit the populated file.
ZVEC_GREP_IMAGE_DIGEST=sha256:<verified-zvec-grep-manifest-or-platform-digest>
ZVEC_GREP_PROXY_IMAGE_DIGEST=sha256:<verified-loopback-proxy-manifest-or-platform-digest>
