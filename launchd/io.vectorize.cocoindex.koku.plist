<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.vectorize.cocoindex.koku</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.hindsight/with-config-env.sh</string>
        <string>__HOME__/.hindsight/venv/bin/engram-flows-koku</string>
        <string>--mode</string>
        <string>live</string>
        <!-- docs/issues are back in live mode as of 2026-08-14: their banks
             (koku-docs, koku-issues) are now configured with
             retain_extraction_mode=chunks + enable_observations=false, so
             hindsight_retain() stores raw chunks with local ONNX embeddings
             only -- no LLM call at all. See docs/findings/2026-08.md
             2026-08-14 "chunks-mode ingestion" decision (supersedes the
             2026-08-13 "retain/reflect on-demand" code-only restriction for
             this app). -->
        <string>--apps</string>
        <string>docs</string>
        <string>issues</string>
        <string>code</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>KOKU_REPO_DIR</key>
        <string>__HOME__/go/src/github.com/project-koku/koku</string>
        <key>KOKU_SERVICE_OPERATOR_REPO_DIR</key>
        <string>__HOME__/go/src/github.com/project-koku/koku-service-operator</string>
        <key>HINDSIGHT_URL</key>
        <string>http://localhost:8888</string>
        <key>COCOINDEX_PG_URL</key>
        <string>postgresql://hindsight:hindsight@localhost:5432/hindsight</string>
        <!-- code_app's pgvector pool -- right-sized down from asyncpg's own
             min_size=10/max_size=10 default, since every onboarded project's
             cocoindex-flows.py opens its own pool against this same shared
             Postgres instance. See docs/FINDINGS.md 2026-08-03. -->
        <key>COCOINDEX_PG_POOL_MIN_SIZE</key>
        <string>2</string>
        <key>COCOINDEX_PG_POOL_MAX_SIZE</key>
        <string>5</string>
        <key>PATH</key>
        <string>__HOME__/.hindsight/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__HOME__/.hindsight</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.hindsight/logs/cocoindex-koku-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.hindsight/logs/cocoindex-koku-stderr.log</string>
</dict>
</plist>
