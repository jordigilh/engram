#!/usr/bin/env bash
# Explicitly opt into the mutable checkout while keeping production config
# pointed at the versioned GitHub Release artifact.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
CONFIG="${ENGRAM_OPENCODE_DEV_CONFIG:-${REPO_ROOT}/deploy/opencode-plugin.local.jsonc}"
OPENCODE_BIN="${OPENCODE_BIN:-opencode}"

if [ ! -f "${CONFIG}" ]; then
  printf 'engram plugin dev config not found: %s\n' "${CONFIG}" >&2
  exit 1
fi

printf 'engram plugin development override: %s\n' "${CONFIG}" >&2
exec env OPENCODE_CONFIG="${CONFIG}" "${OPENCODE_BIN}" "$@"
